# Required for the "Request Brochure" endpoint (api/request-brochure.ts)
# Get an API key from https://resend.com after verifying a sending domain.
RESEND_API_KEY=

# Optional: the "From" address used when sending the brochure email.
# Must be on a domain verified in Resend. Defaults to a placeholder if unset.
BROCHURE_FROM_EMAIL="Royale Isles Lanka <brochure@royaleisleslanka.com>"
