# Royale Isles Lanka — environment variables

# Confirmed WhatsApp Business number (digits only, with country code).
# Omit or leave unset to hide WhatsApp actions in the prototype.
# The default placeholder number in code is NOT shown to travellers.
# VITE_WHATSAPP_NUMBER=94771234567

# Mapbox token for My Journey map (optional for map features)
# VITE_MAPBOX_ACCESS_TOKEN=
