# Base URL of the ril-backend FastAPI service (see ../ril-backend).
# Defaults to http://localhost:8000 if unset, which matches `uvicorn app.main:app --port 8000`.
VITE_API_BASE_URL=http://localhost:8000

# Mapbox GL JS public access token (pk.*). Without it, TravelMap silently skips
# initializing the map (no error is shown). Must be prefixed with VITE_ so Vite
# exposes it to client code, and set for every hosting environment (e.g. Vercel
# Project Settings -> Environment Variables) — then redeploy, since Vite bakes
# env vars into the build at build time, not runtime.
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token

# Traveller dashboard app URL. The main-site /login/traveller page hands travellers
# off here (the dashboard owns login/sign-up/Google). Defaults to http://localhost:3000.
VITE_DASHBOARD_URL=http://localhost:3000

# Google Sign-In: OAuth 2.0 Web client ID (same value as ril-backend GOOGLE_CLIENT_ID).
# Leave empty to hide the Google button; email/password auth still works.
VITE_GOOGLE_CLIENT_ID=
